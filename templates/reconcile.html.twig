{#
 # SAC — reconcile queue. One row per signal; resolve / re-open inline.
 # Autoescape ON — no |raw on plugin data. CSRF token field on every form.
 # `action` = front/reconcile.php prefixed URL.
 # `rows` = Reconcile::listForDisplay(include_resolved).
 # `include_resolved` bool, `toggle_url` = link that flips the view.
 # `can_act` = may map / resolve / re-open (UPDATE + access to root);
 # `sees_all` = the rows are not filtered by entity.
 #}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="card-title">
            {{ include_resolved ? __('All reconcile signals', 'sac') : __('Open reconcile signals', 'sac') }}
        </span>
        <a href="{{ toggle_url }}" class="btn btn-sm btn-outline-secondary">
            {{ include_resolved ? __('Hide resolved', 'sac') : __('Show resolved', 'sac') }}
        </a>
    </div>
    <div class="card-body">
        {% if not sees_all %}
            <div class="alert alert-secondary">
                {{ __('Showing only the operating systems found on assets of your entities.', 'sac') }}
            </div>
        {% endif %}
        {% if not can_act %}
            <div class="alert alert-secondary">
                {{ __('A mapping applies to every entity, so mapping and resolving are done at group level (access to the root entity).', 'sac') }}
            </div>
        {% endif %}
        <div class="alert alert-info">
            <p class="mb-1">
                {{ __('An EOL / no_mapping row means SAC found an operating system + version pair but has no end-of-life date for it.', 'sac') }}
            </p>
            <ul class="mb-0">
                <li>
                    {{ __('Enter the endoflife.date product slug + release cycle (see', 'sac') }}
                    <a href="https://endoflife.date" target="_blank" rel="noopener">endoflife.date</a>{{ __('), e.g.', 'sac') }}
                    <code>rhel</code> / <code>9</code> {{ __('for RHEL 9.x,', 'sac') }}
                    <code>ubuntu</code> / <code>22.04</code> {{ __('for Ubuntu 22.04,', 'sac') }}
                    <code>windows-server</code> / <code>2019</code>, <code>vmware-esxi</code> / <code>7.0</code> —
                    {{ __('then', 'sac') }} <strong>{{ __('Map & resolve', 'sac') }}</strong>.
                    {{ __('SAC then keeps this exact OS + version pair up to date automatically.', 'sac') }}
                </li>
                <li>
                    {{ __('Or set the date directly on', 'sac') }}
                    <strong>{{ __('Assets → Operating Systems → (OS) → LifeCycle → EndOfLife', 'sac') }}</strong>
                    {{ __('(or on the specific OS Version, for finer control — a version-level date wins)', 'sac') }}
                    — {{ __('that takes priority over the mapping and needs no slug.', 'sac') }}
                </li>
                <li>
                    <strong>{{ __('Resolve', 'sac') }}</strong>
                    {{ __('just dismisses the row without a mapping (no Finding for that OS + version).', 'sac') }}
                </li>
            </ul>
        </div>
    {% if rows is empty %}
        <div class="text-center text-muted">{{ __('Nothing to reconcile', 'sac') }}</div>
    {% else %}
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th data-sortable>{{ __('Status', 'sac') }}</th>
                    <th data-sortable>{{ __('Signal', 'sac') }}</th>
                    <th data-sortable>{{ __('Reason', 'sac') }}</th>
                    <th data-sortable>{{ __('Reference', 'sac') }}</th>
                    <th data-sortable>{{ __('Mapping', 'sac') }}</th>
                    <th data-sortable>{{ __('First seen', 'sac') }}</th>
                    <th data-sortable>{{ __('Last seen', 'sac') }}</th>
                    <th>{{ __('Actions', 'sac') }}</th>
                </tr>
            </thead>
            <tbody>
            {% for row in rows %}
                <tr class="{{ row.is_resolved ? 'text-muted' : '' }}">
                    <td>
                        {% if row.is_resolved %}
                            <span class="badge bg-success text-white">{{ __('Resolved', 'sac') }}</span>
                        {% else %}
                            <span class="badge bg-warning text-dark">{{ __('Open', 'sac') }}</span>
                        {% endif %}
                    </td>
                    <td>{{ row.signal_type }}</td>
                    <td>{{ row.reason }}</td>
                    <td data-sort="{{ row.label }}">
                        {{ row.label }}
                        {% if row.ref_id > 0 %}
                            <small class="text-muted">({{ row.ref_itemtype }} #{{ row.ref_id }})</small>
                        {% endif %}
                    </td>
                    <td>
                        {% if row.eol_product %}
                            <code>{{ row.eol_product }} / {{ row.eol_cycle }}</code>
                        {% else %}
                            <span class="text-muted">&mdash;</span>
                        {% endif %}
                    </td>
                    <td>{{ row.date_firstseen }}</td>
                    <td>{{ row.date_lastseen }}</td>
                    <td>
                    {% if not can_act %}
                        <span class="text-muted">&mdash;</span>
                    {% elseif row.is_resolved %}
                        <form method="post" action="{{ action }}" class="d-inline">
                            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                            <input type="hidden" name="id" value="{{ row.id }}">
                            <button type="submit" name="reopen" value="{{ row.id }}"
                                    class="btn btn-sm btn-outline-secondary">
                                {{ __('Re-open', 'sac') }}
                            </button>
                        </form>
                    {% else %}
                        {% if row.signal_type == 'eol' and row.reason == 'no_mapping' %}
                            <form method="post" action="{{ action }}" class="d-inline-flex gap-1 align-items-center me-2">
                                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                <input type="hidden" name="id" value="{{ row.id }}">
                                <input type="text" name="product" class="form-control form-control-sm"
                                       value="{{ row.eol_product }}"
                                       placeholder="{{ __('product', 'sac') }}" required>
                                <input type="text" name="cycle" class="form-control form-control-sm"
                                       value="{{ row.eol_cycle }}"
                                       placeholder="{{ __('cycle', 'sac') }}" required>
                                <button type="submit" name="map" value="{{ row.id }}" class="btn btn-sm btn-primary">
                                    {{ __('Map & resolve', 'sac') }}
                                </button>
                            </form>
                        {% endif %}
                        <form method="post" action="{{ action }}" class="d-inline">
                            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                            <input type="hidden" name="id" value="{{ row.id }}">
                            <button type="submit" name="resolve" value="{{ row.id }}"
                                    class="btn btn-sm btn-outline-secondary">
                                {{ __('Resolve', 'sac') }}
                            </button>
                        </form>
                    {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        {% include '@sac/_sortable-table.html.twig' %}
    {% endif %}
    </div>
</div>
