{#
 # SAC — overview dashboard. One status card per module.
 # Autoescape ON — no |raw on plugin data.
 # `cards` = [{module, date_end, status, counts, open_reconcile, findings_url}]
 # `riskregister` = bool (riskregister plugin available).
 #}
{% set count_labels = {
    'scanned':          __('Scanned', 'sac'),
    'findings_upserted':__('Findings written', 'sac'),
    'findings_cleared': __('Findings cleared', 'sac'),
    'reconcile_open':   __('Reconcile added', 'sac'),
    'errors':           __('Errors', 'sac'),
    'skipped':          __('Skipped (not an OS)', 'sac'),
    'cache_pending':    __('Awaiting endoflife.date', 'sac')
} %}
{#
 # `eolcache` is NOT a security-signal module like `eol`/`license` — it's the
 # internal cron that refreshes the local endoflife.date mirror those scans
 # read from. Shown as its own card only for run-health visibility, but with
 # a distinct title + description so it doesn't read as a 3rd signal type.
 #}
{% set card_titles = {
    'eol':      __('EOL / EOS', 'sac'),
    'license':  __('License Governance', 'sac'),
    'eolcache': __('EOL Cache Refresh', 'sac')
} %}
{% set card_descriptions = {
    'eol':      __('Security signal — OS and hardware end-of-life.', 'sac'),
    'license':  __('Security signal — license compliance.', 'sac'),
    'eolcache': __('Internal maintenance, not a security signal — refreshes the local endoflife.date mirror the EOL scan above reads from. A problem here means the refresh failed, not that any asset is at risk.', 'sac')
} %}
<div class="row row-cards">
{% if cards is empty %}
    <div class="col-12">
        <div class="card">
            <div class="card-body text-center text-muted">
                {{ __('No scans yet', 'sac') }}
            </div>
        </div>
    </div>
{% else %}
    {% for card in cards %}
    {% set st = card.status|default('') %}
    {% set st_bg = st == 'error' ? 'bg-danger' : (st == 'ok' ? 'bg-success' : 'bg-secondary') %}
    <div class="col-sm-6 col-lg-4">
        <div class="card">
            <div class="card-status-top {{ st_bg }}"></div>
            <div class="card-header">
                <h3 class="card-title">{{ card_titles[card.module]|default(card.module|upper) }}</h3>
                <div class="card-actions">
                    {% if st %}
                        <span class="badge {{ st_bg }} text-white">
                            {{ st == 'ok' ? __('OK', 'sac') : (st == 'error' ? __('Error', 'sac') : st) }}
                        </span>
                    {% endif %}
                </div>
            </div>
            <div class="card-body">
                {% if card_descriptions[card.module] is defined %}
                    <div class="text-muted small mb-2">{{ card_descriptions[card.module] }}</div>
                {% endif %}

                <div class="text-muted small mb-2">
                    {% if card.date_end %}
                        {{ __('Last run', 'sac') }}: {{ card.date_end }}
                    {% else %}
                        {{ __('Never run', 'sac') }}
                    {% endif %}
                </div>

                {% if st == 'error' and card.message %}
                    <div class="alert alert-danger small py-1 px-2 mb-2">{{ card.message }}</div>
                {% endif %}

                <div class="datagrid">
                {% for k, v in card.counts %}
                    <div class="datagrid-item">
                        <div class="datagrid-title">{{ count_labels[k]|default(k|replace({'_': ' '})) }}</div>
                        <div class="datagrid-content{{ k == 'errors' and v > 0 ? ' text-danger fw-bold' : '' }}">{{ v }}</div>
                    </div>
                {% endfor %}
                {% if card.module != 'eolcache' %}
                    <div class="datagrid-item">
                        <div class="datagrid-title">{{ __('Open reconcile', 'sac') }}</div>
                        <div class="datagrid-content fw-bold">{{ card.open_reconcile }}</div>
                    </div>
                {% endif %}
                </div>

                {% if card.findings_url %}
                    <div class="mt-3">
                        <a href="{{ card.findings_url }}" class="btn btn-sm btn-outline-primary">
                            {{ __('View findings', 'sac') }}
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
    {% endfor %}
{% endif %}
</div>

{#
 # `summary` = Summary::build(): open SAC findings the user may see, per
 # entity (+ total) and per signal across entities. Plain numbers, no
 # coloured count badges (suite rule).
 #}
{% if summary is not null %}
{% set severities = ['Critical', 'High', 'Medium', 'Low'] %}
<div class="row row-cards mt-1">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">{{ __('Open findings by entity', 'sac') }}</h3>
            </div>
            {% if summary.entities is empty %}
                <div class="card-body text-center text-muted">{{ __('No open findings', 'sac') }}</div>
            {% else %}
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>{{ __('Entity', 'sac') }}</th>
                            <th class="text-end">{{ __('EOL / EOS', 'sac') }}</th>
                            <th class="text-end">{{ __('License', 'sac') }}</th>
                            {% for s in severities %}<th class="text-end">{{ s }}</th>{% endfor %}
                            <th class="text-end">{{ __('Hosts', 'sac') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for e in summary.entities %}
                        <tr>
                            <td>{{ e.name }}</td>
                            <td class="text-end">{{ e.eol }}</td>
                            <td class="text-end">{{ e.license }}</td>
                            {% for s in severities %}
                                <td class="text-end{{ e[s] == 0 ? ' text-muted' : '' }}">{{ e[s] }}</td>
                            {% endfor %}
                            <td class="text-end">{{ e.hosts }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                    {% if summary.entities|length > 1 %}
                    <tfoot>
                        <tr class="fw-bold">
                            <td>{{ __('All entities shown', 'sac') }}</td>
                            <td class="text-end">{{ summary.total.eol }}</td>
                            <td class="text-end">{{ summary.total.license }}</td>
                            {% for s in severities %}<td class="text-end">{{ summary.total[s] }}</td>{% endfor %}
                            <td class="text-end">{{ summary.total.hosts }}</td>
                        </tr>
                    </tfoot>
                    {% endif %}
                </table>
            </div>
            {% endif %}
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">{{ __('Signals affecting the most hosts', 'sac') }}</h3>
            </div>
            {% if summary.signals is empty %}
                <div class="card-body text-center text-muted">{{ __('No open findings', 'sac') }}</div>
            {% else %}
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>{{ __('Signal', 'sac') }}</th>
                            <th>{{ __('Severity', 'sac') }}</th>
                            <th class="text-end">{{ __('Entities', 'sac') }}</th>
                            <th class="text-end">{{ __('Hosts', 'sac') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for sig in summary.signals %}
                        <tr>
                            <td>{{ sig.name }}<div class="text-muted small">{{ sig.code }}</div></td>
                            <td>{{ sig.severity }}</td>
                            <td class="text-end">{{ sig.entities }}</td>
                            <td class="text-end">{{ sig.hosts }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}
        </div>
    </div>
</div>
{% endif %}

{% if not riskregister %}
    <div class="alert alert-warning mt-3">
        {{ __('The riskregister plugin is not active — findings are not being written.', 'sac') }}
    </div>
{% endif %}
