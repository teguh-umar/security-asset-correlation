{#
 # SAC — overview dashboard. Empty state for now; Task 11 fills the cards.
 # Autoescape ON — no |raw on plugin data.
 #}
<div class="row row-cards">
{% if cards is empty %}
    <div class="col-12">
        <div class="card">
            <div class="card-body text-center text-muted">
                {{ __('No scans yet', 'sac') }}
            </div>
        </div>
    </div>
{% else %}
    {% for card in cards %}
    <div class="col-sm-6 col-lg-3">
        <div class="card">
            <div class="card-body">
                <div class="subheader">{{ card.label }}</div>
                <div class="h1 m-0">{{ card.value }}</div>
            </div>
        </div>
    </div>
    {% endfor %}
{% endif %}
</div>
