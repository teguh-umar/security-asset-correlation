{#
 # SAC — overview dashboard. One status card per module.
 # Autoescape ON — no |raw on plugin data.
 # `cards` = [{module, date_end, status, counts, open_reconcile, findings_url}]
 # `riskregister` = bool (riskregister plugin available).
 #}
<div class="row row-cards">
{% if cards is empty %}
    <div class="col-12">
        <div class="card">
            <div class="card-body text-center text-muted">
                {{ __('No scans yet', 'sac') }}
            </div>
        </div>
    </div>
{% else %}
    {% for card in cards %}
    <div class="col-sm-6 col-lg-4">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="subheader text-uppercase">{{ card.module }}</div>
                    {% if card.status %}
                        {% set _sc = card.status == 'ok' ? 'bg-success' : (card.status == 'error' ? 'bg-danger' : 'bg-secondary') %}
                        <span class="badge {{ _sc }}">{{ card.status }}</span>
                    {% endif %}
                </div>

                <div class="text-muted small mt-1">
                    {% if card.date_end %}
                        {{ __('Last run', 'sac') }}: {{ card.date_end }}
                    {% else %}
                        {{ __('Never run', 'sac') }}
                    {% endif %}
                </div>

                <table class="table table-sm table-borderless mb-0 mt-2">
                    <tbody>
                    {% for k, v in card.counts %}
                        <tr>
                            <td class="text-muted py-0">{{ k|replace({'_': ' '}) }}</td>
                            <td class="text-end fw-bold py-0">{{ v }}</td>
                        </tr>
                    {% endfor %}
                        <tr>
                            <td class="text-muted py-0">{{ __('open reconcile', 'sac') }}</td>
                            <td class="text-end fw-bold py-0">{{ card.open_reconcile }}</td>
                        </tr>
                    </tbody>
                </table>

                {% if card.findings_url %}
                    <div class="mt-2">
                        <a href="{{ card.findings_url }}">{{ __('View findings', 'sac') }}</a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
    {% endfor %}
{% endif %}
</div>

{% if not riskregister %}
    <div class="alert alert-info mt-2">
        {{ __('The riskregister plugin is not active — findings are not being written.', 'sac') }}
    </div>
{% endif %}
