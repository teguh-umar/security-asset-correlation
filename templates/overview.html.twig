{#
 # SAC — overview dashboard. One status card per module.
 # Autoescape ON — no |raw on plugin data.
 # `cards` = [{module, date_end, status, counts, open_reconcile, findings_url}]
 # `riskregister` = bool (riskregister plugin available).
 #}
<div class="row row-cards">
{% if cards is empty %}
    <div class="col-12">
        <div class="card">
            <div class="card-body text-center text-muted">
                {{ __('No scans yet', 'sac') }}
            </div>
        </div>
    </div>
{% else %}
    {% for card in cards %}
    <div class="col-sm-6 col-lg-4">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="subheader text-uppercase">{{ card.module }}</div>
                    {% if card.status %}
                        <span class="badge bg-secondary">{{ card.status }}</span>
                    {% endif %}
                </div>

                <div class="text-muted small mt-1">
                    {% if card.date_end %}
                        {{ __('Last run', 'sac') }}: {{ card.date_end }}
                    {% else %}
                        {{ __('Never run', 'sac') }}
                    {% endif %}
                </div>

                <div class="mt-2">
                {% for k, v in card.counts %}
                    <span class="badge bg-secondary me-1">{{ k }}: {{ v }}</span>
                {% endfor %}
                </div>

                <div class="mt-2">
                    <span class="text-muted">{{ __('Open reconcile', 'sac') }}:</span>
                    <strong>{{ card.open_reconcile }}</strong>
                </div>

                {% if card.findings_url %}
                    <div class="mt-2">
                        <a href="{{ card.findings_url }}">{{ __('View findings', 'sac') }}</a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
    {% endfor %}
{% endif %}
</div>

{% if not riskregister %}
    <div class="alert alert-info mt-2">
        {{ __('The riskregister plugin is not active — findings are not being written.', 'sac') }}
    </div>
{% endif %}
