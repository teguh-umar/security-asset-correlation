{#
 # SAC — scan-run history. Read-only; last 50 rows, newest first.
 # Autoescape ON — no |raw on plugin data.
 # Same count_labels map as overview.html.twig — keep the two in sync.
 #}
{% set count_labels = {
    'scanned':          __('Scanned', 'sac'),
    'findings_upserted':__('Findings written', 'sac'),
    'findings_cleared': __('Findings cleared', 'sac'),
    'reconcile_open':   __('Reconcile added', 'sac'),
    'errors':           __('Errors', 'sac'),
    'skipped':          __('Skipped (not an OS)', 'sac'),
    'cache_pending':    __('Awaiting endoflife.date', 'sac')
} %}
<div class="card">
    <div class="card-body">
    {% if runs is empty %}
        <div class="text-center text-muted">{{ __('No scans yet', 'sac') }}</div>
    {% else %}
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>{{ __('Module', 'sac') }}</th>
                    <th>{{ __('Started', 'sac') }}</th>
                    <th>{{ __('Ended', 'sac') }}</th>
                    <th>{{ __('Status', 'sac') }}</th>
                    <th>{{ __('Counts', 'sac') }}</th>
                </tr>
            </thead>
            <tbody>
            {% for r in runs %}
            {% set st_bg = r.status == 'error' ? 'bg-danger' : (r.status == 'ok' ? 'bg-success' : 'bg-secondary') %}
                <tr>
                    <td>{{ r.module }}</td>
                    <td>{{ r.date_start }}</td>
                    <td>{{ r.date_end }}</td>
                    <td>
                        <span class="badge {{ st_bg }} text-white">
                            {{ r.status == 'ok' ? __('OK', 'sac') : (r.status == 'error' ? __('Error', 'sac') : r.status) }}
                        </span>
                        {% if r.status == 'error' and r.message %}
                            <div class="small text-danger mt-1">{{ r.message }}</div>
                        {% endif %}
                    </td>
                    <td>
                    {% for k, v in r.counts %}
                        <div class="small{{ k == 'errors' and v > 0 ? ' text-danger fw-bold' : '' }}">
                            <span class="text-muted">{{ count_labels[k]|default(k|replace({'_': ' '})) }}:</span>
                            <span class="text-body">{{ v }}</span>
                        </div>
                    {% else %}
                        <span class="text-muted">&mdash;</span>
                    {% endfor %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
    </div>
</div>
