{#
 # SAC — per-host SCAP rule checklist (Module 3 Tier 2).
 # Autoescape ON — no |raw on plugin data.
 # `rules` = [{rule_id, result, severity, framework_refs, title, state,
 #            date_first_seen, date_last_seen, date_resolved}], worst first.
 #}
<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title">
            {{ __('Failing rules', 'sac') }} — <a href="{{ computer_url }}">{{ computer_name }}</a>
        </h3>
        <div class="card-actions">
            <a href="{{ back_url }}" class="btn btn-sm btn-outline-secondary">{{ __('Back to Config compliance', 'sac') }}</a>
        </div>
    </div>
    <div class="card-body">
        <div class="alert alert-secondary">
            {{ __('A rule closes automatically when a later scan no longer reports it failing, and reopens if it comes back. Statuses you set yourself live on the Risk Register finding, not here.', 'sac') }}
        </div>

        <div class="datagrid mb-3">
            <div class="datagrid-item">
                <div class="datagrid-title">{{ __('Open', 'sac') }}</div>
                <div class="datagrid-content fw-bold{{ open_count > 0 ? ' text-danger' : '' }}">{{ open_count }}</div>
            </div>
            <div class="datagrid-item">
                <div class="datagrid-title">{{ __('Resolved', 'sac') }}</div>
                <div class="datagrid-content">{{ resolved_count }}</div>
            </div>
        </div>

    {% if rules is empty %}
        <div class="text-center text-muted">
            {{ __('No per-rule results for this host yet. The host needs the current oscap wrapper deployed — an older wrapper reports only the overall score.', 'sac') }}
        </div>
    {% else %}
        <table class="table table-hover">
            <thead>
                <tr>
                    <th data-sortable>{{ __('Severity', 'sac') }}</th>
                    <th data-sortable>{{ __('Rule', 'sac') }}</th>
                    <th data-sortable>{{ __('Framework', 'sac') }}</th>
                    <th data-sortable>{{ __('State', 'sac') }}</th>
                    <th data-sortable>{{ __('First seen', 'sac') }}</th>
                    <th data-sortable>{{ __('Last seen', 'sac') }}</th>
                    <th data-sortable>{{ __('Resolved', 'sac') }}</th>
                </tr>
            </thead>
            <tbody>
            {% set sev_rank = {'high': 0, 'medium': 1, 'low': 2, 'unknown': 3} %}
            {% for r in rules %}
                {% set resolved = r.state == 'resolved' %}
                {% set sev_class = r.severity == 'high' ? 'text-danger fw-bold'
                                 : (r.severity == 'medium' ? 'text-warning fw-bold'
                                 : 'text-muted') %}
                <tr class="{{ resolved ? 'text-muted' : '' }}">
                    <td data-sort="{{ sev_rank[r.severity]|default(9) }}" class="{{ resolved ? '' : sev_class }}">
                        {{ r.severity }}
                    </td>
                    <td>
                        {{ r.title }}
                        <div class="text-muted small">{{ r.rule_id }}</div>
                    </td>
                    <td class="small">
                        {% if r.framework_refs %}
                            {{ r.framework_refs }}
                        {% else %}
                            <span class="text-muted">&mdash;</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if resolved %}
                            <span class="badge bg-success text-white">{{ __('Resolved', 'sac') }}</span>
                        {% else %}
                            <span class="badge bg-danger text-white">{{ __('Open', 'sac') }}</span>
                        {% endif %}
                        {% if r.result == 'error' %}
                            <span class="badge bg-secondary text-white ms-1" title="{{ __('The scanner could not evaluate this rule', 'sac') }}">{{ __('error', 'sac') }}</span>
                        {% endif %}
                    </td>
                    <td class="small">{{ r.date_first_seen }}</td>
                    <td class="small">{{ r.date_last_seen }}</td>
                    <td class="small">{{ r.date_resolved ?: '' }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        {% include '@sac/_sortable-table.html.twig' %}
    {% endif %}
    </div>
</div>
