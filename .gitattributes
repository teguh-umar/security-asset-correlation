# lib/pgnsuite/ConfigTab.php is a byte-identical copy of a canonical file
# shared across the PGN plugin suite (hub §5 contract), verified by SHA-256
# before every commit. `-text` stops git from EVER touching its line endings
# (on checkout, on `git archive`, on diff) regardless of core.autocrlf —
# without it, autocrlf=true silently re-wrote LF -> CRLF both in the working
# copy AND in `git archive` output (confirmed: it broke sacv1.3.1.zip, not
# just the local checkout).
lib/pgnsuite/ConfigTab.php -text
lib/pgnsuite/Menu.php -text
